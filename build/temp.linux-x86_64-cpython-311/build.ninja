ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -Wsign-compare -DNDEBUG -g -fwrapv -O2 -Wall -g -fstack-protector-strong -Wformat -Werror=format-security -g -fwrapv -O2 -fPIC -I/workspace/cutlass/include -I/workspace/cutlass/tools/util/include -I/usr/local/lib/python3.11/dist-packages/torch/include -I/usr/local/lib/python3.11/dist-packages/torch/include/torch/csrc/api/include -I/usr/local/lib/python3.11/dist-packages/torch/include/TH -I/usr/local/lib/python3.11/dist-packages/torch/include/THC -I/usr/local/cuda/include -I/usr/include/python3.11 -c
post_cflags = -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=modiff_cutlass -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -I/workspace/cutlass/include -I/workspace/cutlass/tools/util/include -I/usr/local/lib/python3.11/dist-packages/torch/include -I/usr/local/lib/python3.11/dist-packages/torch/include/torch/csrc/api/include -I/usr/local/lib/python3.11/dist-packages/torch/include/TH -I/usr/local/lib/python3.11/dist-packages/torch/include/THC -I/usr/local/cuda/include -I/usr/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -std=c++17 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=modiff_cutlass -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/attn_quant_gemm.o: cuda_compile /workspace/MoDiff/csrc/kernels/attn_quant_gemm.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/conv2d_int4.o: cuda_compile /workspace/MoDiff/csrc/kernels/conv2d_int4.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/conv2d_int8.o: cuda_compile /workspace/MoDiff/csrc/kernels/conv2d_int8.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/conv_epilogue.o: cuda_compile /workspace/MoDiff/csrc/kernels/conv_epilogue.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/flash_attn_int8.o: cuda_compile /workspace/MoDiff/csrc/kernels/flash_attn_int8.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/fused_gn_qkv.o: cuda_compile /workspace/MoDiff/csrc/kernels/fused_gn_qkv.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/gemm_wxax.o: cuda_compile /workspace/MoDiff/csrc/kernels/gemm_wxax.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/group_norm_silu.o: cuda_compile /workspace/MoDiff/csrc/kernels/group_norm_silu.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/layout_transform.o: cuda_compile /workspace/MoDiff/csrc/kernels/layout_transform.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/modiff_delta_quantize.o: cuda_compile /workspace/MoDiff/csrc/kernels/modiff_delta_quantize.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/quantize.o: cuda_compile /workspace/MoDiff/csrc/kernels/quantize.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/kernels/quantize_qkv.o: cuda_compile /workspace/MoDiff/csrc/kernels/quantize_qkv.cu
build /workspace/MoDiff/build/temp.linux-x86_64-cpython-311/csrc/pybind.o: compile /workspace/MoDiff/csrc/pybind.cpp






