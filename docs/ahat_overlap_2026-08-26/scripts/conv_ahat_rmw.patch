+    int sh, int sw, int ph, int pw, int dh, int dw, bool post_epilogue) {
+  CHECK_CUDA(o_hat); TORCH_CHECK(o_hat.scalar_type()==torch::kFloat16, "o_hat fp16");
+  CHECK_CUDA(a_hat); TORCH_CHECK(a_hat.scalar_type()==torch::kFloat16, "a_hat fp16");
+  TORCH_CHECK(a_hat.numel() % 2 == 0, "a_hat numel must be even (vec2 RMW)");
+  TORCH_CHECK(code.numel() == a_hat.numel(), "code and a_hat must have the same element count");
+  int N=input.size(0),C=input.size(1),H=input.size(2),W=input.size(3),K=weight.size(0),R=weight.size(1),S=weight.size(2);
