+  run_d2nr<I8,int8_t>(
+      input.data_ptr<int8_t>(), weight.data_ptr<int8_t>(), inv_scale.data_ptr<float>(),
+      weight_scales.data_ptr<float>(),
+      reinterpret_cast<EC*>(o_hat.data_ptr<at::Half>()), problem, C,R,S,K,M,ldK,
+      at::cuda::getCurrentCUDAStream(),
+      reinterpret_cast<__half*>(a_hat.data_ptr<at::Half>()),
+      code.data_ptr<int8_t>(), (float)ahat_inv_scale,
+      post_epilogue ? -(long)a_hat.numel() : (long)a_hat.numel());
+  return o_hat;
+}
